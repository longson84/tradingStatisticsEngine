{
  "name": "trading-engine-fullstack",
  "version": "0.1.0",
  "description": "Trading Statistics Engine - Full Stack Application",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "UV_CACHE_DIR=.cache/uv uv run --no-sync uvicorn api.main:app --reload --port 8000",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "build:frontend": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "lint:frontend": "pnpm --filter frontend lint",
    "preview": "pnpm --filter frontend preview",
    "type-check": "pnpm --filter frontend type-check",
    "generate:api": "UV_CACHE_DIR=.cache/uv uv run --no-sync python -m scripts.export_openapi && pnpm --filter frontend generate:api",
    "check:api-types": "UV_CACHE_DIR=.cache/uv uv run --no-sync python -m scripts.check_api_types",
    "check:vnstock": ".venv/bin/python -m scripts.setup_vnstock_data --check",
    "setup:vnstock": ".venv/bin/python -m scripts.setup_vnstock_data",
    "sync:binance": "UV_CACHE_DIR=.cache/uv uv run --no-sync python -m scripts.sync_binance_spot",
    "sync:equity-venues": "UV_CACHE_DIR=.cache/uv uv run --no-sync python -m scripts.sync_equity_venues",
    "sync:reference-rates": "UV_CACHE_DIR=.cache/uv uv run --no-sync python -m scripts.sync_reference_rates",
    "test": "UV_CACHE_DIR=.cache/uv uv run --no-sync pytest",
    "test:watch": "UV_CACHE_DIR=.cache/uv uv run --no-sync pytest -w",
    "start": "pnpm run dev",
    "setup": "pnpm install && UV_CACHE_DIR=.cache/uv uv sync --all-groups --inexact && .venv/bin/python -m scripts.setup_vnstock_data --force",
    "clean": "pnpm --filter frontend clean && rm -rf node_modules .pnpm-store",
    "clean:all": "pnpm clean && uv venv --remove"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
